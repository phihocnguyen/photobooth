# Local development. For production, point the API to
# https://vixoaidanloi.com/photobooth and point the public URL to your Vercel site.
GALLERY_API_URL=http://127.0.0.1:3000
GALLERY_PUBLIC_URL=http://127.0.0.1:3000
GALLERY_UPLOAD_KEY=replace-with-the-same-key-as-the-gallery
# Optional fallback when Electron cannot record H.264 directly.
# PHOTOBOOTH_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
