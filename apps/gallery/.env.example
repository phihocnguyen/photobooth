# Neon PostgreSQL connection string. Keep it on the VPS.
# DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
GALLERY_UPLOAD_KEY=replace-with-a-long-random-key
# Production: use an absolute path on the VPS, e.g. /var/lib/photobooth/media.
# GALLERY_MEDIA_DIR=/var/lib/photobooth/media
GALLERY_RETENTION_DAYS=30
# Local development only, without Neon.
GALLERY_LOCAL_DB=1
# Optional: open a seeded demo album from the homepage in development.
# GALLERY_DEMO_TOKEN=
# When deploying only the frontend to Vercel, set these two variables instead
# of the database, media or upload settings below.
# GALLERY_ROLE=web
# GALLERY_API_URL=https://vixoaidanloi.com/photobooth

